# ==============================================
# Ambiente
# ==============================================
NODE_ENV=development
PORT=3000

# URL pública do site — usada em CORS e nos back_urls do Mercado Pago
FRONTEND_URL=https://teacheradilson.com.br

# URL pública deste backend — usada como notification_url das Preferences
BACKEND_URL=https://api.teacheradilson.com.br

# ==============================================
# Banco de dados (PostgreSQL)
# ==============================================
DATABASE_URL=postgresql://user:password@localhost:5432/teacher_adilson?schema=public

# ==============================================
# Mercado Pago
# ==============================================
MERCADOPAGO_ACCESS_TOKEN=
# Secret usado para validar a assinatura (x-signature) do webhook — ver Módulo 3
MERCADOPAGO_WEBHOOK_SECRET=

# ==============================================
# Meta Conversion API
# ==============================================
META_PIXEL_ID=871942722527879
META_ACCESS_TOKEN=
# Opcional — só para testar no Events Manager (Test Events)
META_TEST_EVENT_CODE=

# ==============================================
# Logs
# ==============================================
LOG_LEVEL=info
